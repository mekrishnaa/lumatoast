{
  "name": "lumatoast",
  "version": "0.1.1",
  "description": "Beautiful animated toast notification library inspired by Linear and VisionOS.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite playground --host",
    "build": "tsup",
    "build:watch": "tsup --watch",
    "build:playground": "vite build playground --outDir ../dist-playground --emptyOutDir",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "keywords": [
    "toast",
    "notification",
    "typescript",
    "javascript",
    "animation",
    "ui",
    "toast-library",
    "toast-notification",
    "vanilla-js",
    "angular",
    "react",
    "vue",
    "svelte",
    "solidjs",
    "web-components",
    "glassmorphism",
    "accessible"
  ],
  "author": "Krishna Kumar",
  "license": "MIT",
  "homepage": "https://lumatoast.vercel.app",
  "bugs": {
    "url": "https://github.com/mekrishnaa/lumatoast/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mekrishnaa/lumatoast.git"
  },
  "sideEffects": [
    "*.css",
    "./dist/styles.css"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.2",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
